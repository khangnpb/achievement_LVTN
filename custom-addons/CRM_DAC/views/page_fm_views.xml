<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_page_fm_page_simplified_search" model="ir.ui.view">
        <field name="name">page.fm.page.simplified.search</field>
        <field name="model">page.fm.page</field>
        <field name="arch" type="xml">
            <search string="Search Synced Pages">
                <field name="name"/>
                <field name="page_fm_id_str" string="Page.fm ID"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_page_fm_page_simplified_tree" model="ir.ui.view">
        <field name="name">page.fm.page.simplified.tree</field>
        <field name="model">page.fm.page</field>
        <field name="arch" type="xml">
            <tree string="Page.fm Pages (Synced IDs)">
                <field name="name"/>
                <field name="page_fm_id_str" string="Page.fm ID"/>
                <field name="conversation_count" string="Conversations"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_page_fm_page_simplified_form" model="ir.ui.view">
        <field name="name">page.fm.page.simplified.form</field>
        <field name="model">page.fm.page</field>
        <field name="arch" type="xml">
            <form string="Page.fm Page (Synced ID)">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_conversations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-comments"
                                attrs="{'invisible': [('conversation_count', '=', 0)]}">
                            <field name="conversation_count" widget="statinfo" string="Conversations"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Page Name (from API)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="page_fm_id_str" string="Page.fm External ID" readonly="1" attrs="{'invisible': [('page_fm_id_str', '=', False)]}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_page_fm_page_simplified" model="ir.actions.act_window">
        <field name="name">Page.fm Synced Pages</field>
        <field name="res_model">page.fm.page</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_page_fm_page_simplified_search"/>
        <field name="context">{'trigger_page_fm_sync_on_search_read': True}</field> 
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Page.fm pages found.
            </p>
        </field>
    </record>

    <record id="view_page_fm_conversation_search" model="ir.ui.view">
        <field name="name">page.fm.conversation.search</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="name" string="Customer/Conv ID"/>
                <field name="customer_name_fm"/>
                <field name="conversation_fm_id"/>
                <field name="last_message_snippet"/>
                <field name="platform_fm"/>
                <field name="page_fm_id_str_related" string="Page FM ID"/>
                <filter string="Unread" name="filter_unread" domain="[('is_unread_fm', '=', True)]"/>
                <filter string="Read" name="filter_read" domain="[('is_unread_fm', '=', False)]"/>
                <separator/>
                <field name="page_fm_page_id" string="Page (Odoo)"/>
                <group expand="0" string="Group By">
                    <filter string="Page" name="group_by_page" context="{'group_by': 'page_fm_page_id'}"/>
                    <filter string="Platform" name="group_by_platform" context="{'group_by': 'platform_fm'}"/>
                    <filter string="Read Status" name="group_by_is_unread" context="{'group_by': 'is_unread_fm'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_page_fm_conversation_tree" model="ir.ui.view">
        <field name="name">page.fm.conversation.tree</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <tree string="Conversations" decoration-bf="is_unread_fm == True" decoration-muted="is_unread_fm == False">
                <field name="name" string="Customer/Conv ID"/>
                <field name="last_message_snippet" string="Last Message"/>
                <field name="platform_fm"/>
                <field name="updated_at_fm"/>
                <field name="is_unread_fm" widget="boolean_toggle"/>
                <field name="page_fm_page_id" optional="show" string="Page (Odoo)"/>
                <field name="page_fm_id_str_related" optional="hidden"/>
            </tree>
        </field>
    </record>

    <record id="view_page_fm_conversation_form" model="ir.ui.view">
        <field name="name">page.fm.conversation.form</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                 <header>
                    <button name="action_sync_messages" type="object" string="Sync Messages" class="oe_highlight" context="{'load_all': False}"/>
                    <button name="action_sync_messages" type="object" string="Load All Messages" 
                            context="{'load_all': True}" attrs="{'invisible': [('message_count', '=', 0)]}"/> 
                </header>
                <sheet>
                     <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" type="object" name="action_sync_messages" 
                                context="{'load_all': False}" icon="fa-refresh">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Messages</span>
                                <field name="message_count" widget="statinfo" nolabel="1"/>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="conversation_fm_id" readonly="1"/>
                            <field name="page_fm_page_id" options="{'no_create': True, 'no_open': False}" readonly="1"/>
                            <field name="page_fm_id_str_related" readonly="1"/>
                        </group>
                        <group>
                            <field name="customer_name_fm" readonly="1"/>
                            <field name="customer_fm_id" readonly="1"/>
                            <field name="platform_fm" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="last_message_snippet" readonly="1"/>
                        <field name="updated_at_fm" readonly="1"/>
                        <field name="is_unread_fm"/>
                        <field name="last_message_sync_fm" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" readonly="1" context="{'tree_view_ref': 'CRM_DAC.view_page_fm_message_tree'}">
                                </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_page_fm_conversation_kanban" model="ir.ui.view">
        <field name="name">page.fm.conversation.kanban</field>
        <field name="model">page.fm.conversation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="platform_fm" quick_create="false"> 
                <field name="name"/>
                <field name="conversation_fm_id"/>
                <field name="customer_name_fm"/>    
                <field name="last_message_snippet"/>
                <field name="updated_at_fm"/>
                <field name="is_unread_fm"/>
                <field name="platform_fm"/>
                <field name="page_fm_page_id"/> 
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click {{ record.is_unread_fm.raw_value ? 'oe_kanban_card_new' : '' }}">
                            <div class="oe_kanban_card_header">
                                <div class="oe_kanban_card_header_title">
                                    <img t-if="record.platform_fm.raw_value === 'Facebook'"
                                         src="/CRM_DAC/static/img/facebook.png"
                                         class="oe_kanban_ κοινωνικός_icon" alt="Facebook" style="width:16px; height:16px; margin-left:4px;"/>
                                    <img t-if="record.platform_fm.raw_value === 'Instagram'"
                                         src="/web/static/img/social/instagram.png"
                                         class="oe_kanban_ κοινωνικός_icon" alt="Instagram" style="width:16px; height:16px; margin-left:4px;"/>
                                    <img t-if="record.platform_fm.raw_value === 'Zalo'"
                                         src="/CRM_DAC/static/img/zalo.png" class="oe_kanban_ κοινωνικός_icon" alt="Zalo" style="width:16px; height:16px; margin-left:4px;"/>
                                    <span t-if="record.platform_fm.raw_value &amp;&amp; !['Facebook', 'Instagram', 'Zalo'].includes(record.platform_fm.raw_value)"
                                          class="badge badge-pill badge-secondary ml-1"><field name="platform_fm"/></span>
                                    <span> </span>
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_body">
                                    <p class="text-muted" style="max-height: 4.5em; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                        <field name="last_message_snippet"/>
                                    </p>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <span><field name="page_fm_page_id" options="{'no_open': True}"/></span>
                                        <t t-if="record.updated_at_fm.raw_value">
                                            <span class="ml-2" title="Last Updated"><i class="fa fa-clock-o mr-1"/> <field name="updated_at_fm" widget="datetime" options="{'format': 'short'}"/></span>
                                        </t>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.is_unread_fm.raw_value" class="badge badge-primary">Mới</span>
                                    </div>
                                </div>
                            </div>
                            <div class="oe_clear"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_page_fm_conversation_all" model="ir.actions.act_window">
        <field name="name">All Conversations</field>
        <field name="res_model">page.fm.conversation</field>
        <field name="view_mode">kanban,tree,form</field> <field name="search_view_id" ref="view_page_fm_conversation_search"/>
        <field name="context">{'search_default_filter_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations found.
            </p>
        </field>
    </record>

    <record id="view_page_fm_message_tree" model="ir.ui.view">
        <field name="name">page.fm.message.tree</field>
        <field name="model">page.fm.message</field>
        <field name="arch" type="xml">
            <tree string="Messages" create="false" delete="false" editable="bottom">
                <field name="inserted_at_fm" string="Time" readonly="1"/>
                <field name="sender_name_fm" string="Sender" readonly="1"/>
                <field name="staff_name_fm" string="Staff" readonly="1"/>
                <field name="name" string="Content Preview" readonly="1"/>
                <field name="attachments_json" optional="hidden" readonly="1"/>
                <button name="action_view_raw_json" type="object" string="JSON" icon="fa-code"/>
            </tree>
        </field>
    </record>

    <record id="view_page_fm_message_raw_json_form" model="ir.ui.view">
        <field name="name">page.fm.message.raw.json.form</field>
        <field name="model">page.fm.message</field>
        <field name="arch" type="xml">
            <form string="Raw Message JSON">
                <sheet>
                    <group>
                        <field name="message_fm_id" readonly="1"/>
                        <field name="inserted_at_fm" readonly="1"/>
                    </group>
                    <field name="raw_json_message" widget="ace" options="{'mode': 'json', 'readonly': true}" style="min-height: 400px;"/>
                </sheet>
                 <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <menuitem id="menu_page_fm_sync_root"
              name="Page.fm Sync"
              web_icon="CRM_DAC,static/description/icon.png" 
              sequence="80"/>

    <menuitem id="menu_page_fm_synced_pages_main"
              name="Synced Pages"
              parent="menu_page_fm_sync_root"
              action="action_page_fm_page_simplified"
              sequence="10"/>

    <menuitem id="menu_page_fm_all_conversations_optional"
              name="All Conversations"
              parent="menu_page_fm_sync_root"
              action="action_page_fm_conversation_all"
              sequence="20"/>

</odoo>